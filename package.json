{
  "name": "ree-reverse-engineer-everything",
  "version": "2.0.0",
  "description": "REE — understand how software works. Static, decoy-resistant analysis of apps and binaries (Electron, JS, WASM, Android, Java, .NET, native, Python, iOS) that gives AI models a clean, honest view of the code. CLI + MCP server.",
  "type": "module",
  "bin": {
    "ree": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./parsers": "./dist/parsers/index.js",
    "./anti-bla": "./dist/anti-bla/index.js",
    "./mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "cli": "node --enable-source-maps dist/cli/index.js",
    "mcp": "node --enable-source-maps dist/mcp/server.js",
    "bench": "tsx benchmarks/harness/run.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "bench:real": "tsx benchmarks/real/run.ts",
    "bench:reconstruct": "tsx benchmarks/reconstruct/run.ts",
    "fixtures:android": "tsx benchmarks/fixtures/fetch-android.ts",
    "fixtures:java": "tsx benchmarks/fixtures/java.ts",
    "fixtures:dotnet": "tsx benchmarks/fixtures/dotnet.ts",
    "fixtures:native": "tsx benchmarks/fixtures/native.ts",
    "bench:pyc": "tsx benchmarks/pyc/evaluate.ts",
    "fixtures:ios": "tsx benchmarks/fixtures/ios.ts",
    "bench:obfuscation": "tsx benchmarks/obfuscation/run.ts",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "prepack": "npm run clean && npm run build"
  },
  "files": [
    "dist",
    "samples",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ai-agents",
    "android",
    "apk",
    "asar",
    "decompiler",
    "deobfuscation",
    "dotnet",
    "electron",
    "elf",
    "ghidra",
    "ipa",
    "jar",
    "llm-security",
    "mcp",
    "model-context-protocol",
    "prompt-injection",
    "pyc",
    "reverse-engineering",
    "security-research",
    "static-analysis",
    "wasm"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "commander": "^12.1.0",
    "ink": "8.0.0",
    "react": "19.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "19.3.0",
    "esbuild": "^0.28.2",
    "javascript-obfuscator": "^5.10.1",
    "terser": "^5.51.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnvitDevadiga/ree.git"
  },
  "homepage": "https://github.com/AnvitDevadiga/ree#readme",
  "bugs": {
    "url": "https://github.com/AnvitDevadiga/ree/issues"
  }
}
